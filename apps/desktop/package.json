{
  "name": "@market/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5175 && cross-env VITE_DEV_SERVER_URL=http://localhost:5175 electron electron/main.cjs --no-sandbox\"",
    "build": "tsc --noEmit && vite build && cp ../../node_modules/@aztec/sqlite3mc-wasm/vendor/jswasm/sqlite3.wasm dist/assets/sqlite3.wasm",
    "start": "electron electron/main.cjs --no-sandbox",
    "preview": "vite preview",
    "package": "yarn build && electron-builder"
  },
  "dependencies": {
    "@aztec/aztec.js": "5.0.1",
    "@aztec/constants": "5.0.1",
    "@aztec/foundation": "5.0.1",
    "@aztec/noir-contracts.js": "5.0.1",
    "@aztec/wallet-sdk": "5.0.1",
    "@aztec/wallets": "5.0.1",
    "@market/contract-bindings": "0.1.0",
    "@market/deployment": "0.1.0",
    "@market/identity": "0.1.0",
    "@market/market-metadata": "0.1.0",
    "@market/arweave-store": "0.1.0",
    "@market/shared-types": "0.1.0",
    "arweave": "1.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simplex-chat": "6.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.4.4",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.22.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "network.aztec.market",
    "productName": "Aztec Market",
    "files": ["dist/**/*", "electron/**/*"],
    "directories": { "output": "release" },
    "asarUnpack": ["node_modules/simplex-chat/**"],
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" },
    "mac": { "target": "dmg" }
  }
}
